# Furlong configuration. Copy to .env and edit; environment variables win
# over this file. Every setting is optional — the defaults run the synthetic
# demo with no external services.

# -- storage ----------------------------------------------------------------
FURLONG_DATA_DIR=data
# FURLONG_DB_PATH=/srv/furlong/furlong.sqlite

# -- data source ------------------------------------------------------------
# synthetic (default, no keys needed) | racing_api
FURLONG_SOURCE=synthetic

# The Racing API (theracingapi.com) — UK & Irish racecards, results and, from
# the Standard plan up, odds from 20+ bookmakers. From about £25/month.
# FURLONG_RACING_API_USERNAME=
# FURLONG_RACING_API_PASSWORD=
# FURLONG_RACING_API_BASE_URL=https://api.theracingapi.com/v1

# -- value engine -----------------------------------------------------------
# Betfair commission on net winnings. 0.02 is attainable on the Basic plan
# for UK/Ireland accounts; raise it if you are on a rewards plan that trades
# commission for promotions.
FURLONG_EXCHANGE_COMMISSION=0.02

# Minimum expected value per unit staked before a bet is suggested.
FURLONG_MIN_EDGE=0.05

# Minimum win probability. Bolton & Chapman's longshot exclusion: relative
# probability errors are largest on outsiders, and the favourite-longshot
# bias makes bookmaker prices there the worst value in racing.
FURLONG_MIN_PROB=0.05

# Hard ceiling on advised odds, for the same reason.
FURLONG_MAX_ODDS=21.0

# Sanity ceiling on probability. A runner priced at near-certainty means a
# walkover or a mis-parsed card, not a free bet.
FURLONG_MAX_PROB=0.90

# Races smaller than this are not priced at all (walkovers, stripped cards).
FURLONG_MIN_FIELD_SIZE=3

# -- staking ----------------------------------------------------------------
# Fraction of full Kelly. Never 1.0: overestimate your edge by 2x at full
# Kelly and expected growth turns negative.
FURLONG_KELLY_FRACTION=0.25

# Bankroll in units, where one unit is 1% of the bank. Plan for 200+: losing
# runs of 24-31 bets are normal at realistic edge sizes.
FURLONG_BANKROLL_UNITS=200

# Caps as a fraction of bankroll.
FURLONG_MAX_STAKE_PCT=0.02
FURLONG_MAX_DAILY_STAKE_PCT=0.10

# -- display ----------------------------------------------------------------
FURLONG_TIMEZONE=Europe/Dublin
